\captionsetup{font={small,singlespacing},
              labelfont=sc,
              labelformat=house,
              labelsep=colon,
              justification=justified,
              singlelinecheck=true,
              margin=1.5em,
              skip=10pt}
\captionsetup[sub]{labelformat=parens, labelfont={normalfont,color=thesisaccent},
                   labelsep=space,
                   font={small,singlespacing},
                   justification=centering,
                   singlelinecheck=true,
                   margin=0pt,
                   skip=4pt}
\setlength{\intextsep}{14pt plus 3pt minus 2pt}
\setlength{\textfloatsep}{22pt plus 4pt minus 4pt}
\setlength{\floatsep}{16pt plus 3pt minus 2pt}
\setlength{\abovecaptionskip}{10pt}
\setlength{\belowcaptionskip}{0pt}
