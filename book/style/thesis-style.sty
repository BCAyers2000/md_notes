% page-ending display when its punctuation closes the sentence; inspect
% sentence boundaries in the final page-composition pass.
\predisplaypenalty=10000
\postdisplaypenalty=500
% Theorem furniture is never split across a page boundary: a statement
% is a single object, and half a definition is worse than a short page
