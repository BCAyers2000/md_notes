%-----------------------------------------------------------------------------!
% THEOREM FURNITURE
% -----------------
% Two registers, both quiet. Statements (proposition, definition) carry a
% small-caps head and an italic body; remarks carry the same head with an
% upright body. Numbered within chapters, sharing one counter so the
% reader can navigate by number alone. Use sparingly: a Definition to fix
% an object, a Proposition for a result the text leans on, a Remark for a
% caveat worth setting apart. Lining figures in the heads via the shared
% counter format.
%-----------------------------------------------------------------------------!
\RequirePackage{amsthm}
% The class predefines theorem/proposition/definition/corollary/remark, all
% sharing one counter, so clear the names and let the house versions below
% own them.
\@for\thmname:={proposition,definition,corollary,remark,theorem,lemma}\do{%
   \expandafter\let\csname\thmname\endcsname\@undefined
   \expandafter\let\csname end\thmname\endcsname\@undefined}
% The counters need clearing as well.  Every one of these is written in the
% class as \newtheorem{name}[theorem], an alias, and on a TeX Live older
% than 2025 that leaves \c@name behind as a \let copy of \c@theorem; the
% \newtheorem calls below then stop with "already defined".
%
% The kernel's own record of the alias has to go with it.  Leave
% \alias@ctr@proposition behind and the \newtheorem below still counts as
% resetting an alias, which is the "Alias counters can not be used in a
% counter reset" warning.
%
% Aliases only.  \c@theorem and \c@example are real counters sitting on
% chapter's reset list, and undefining either kills the next \chapter with
% "You can't use \relax after \the".
\@for\thmname:={proposition,definition,corollary,remark,lemma,axiom}\do{%
   \expandafter\let\csname c@\thmname\endcsname\@undefined
   \expandafter\let\csname the\thmname\endcsname\@undefined
   \expandafter\let\csname p@\thmname\endcsname\@undefined
   \expandafter\let\csname alias@ctr@\thmname\endcsname\@undefined}
\let\theproposition\@undefined
\newtheoremstyle{housestatement}
   {12pt plus 2pt}{8pt plus 2pt}
   {\itshape}
   {0pt}
   {\normalfont\scshape}
   {.}{0.6em}{}
\newtheoremstyle{houseremark}
   {12pt plus 2pt}{8pt plus 2pt}
   {\normalfont}
   {0pt}
   {\normalfont\scshape}
   {.}{0.6em}{}
\theoremstyle{housestatement}
\newtheorem{proposition}{Proposition}[chapter]
\newtheorem{definition}[proposition]{Definition}
\newtheorem{corollary}[proposition]{Corollary}
\theoremstyle{houseremark}
\newtheorem{remark}[proposition]{Remark}
% the statement number in accent-teal lining figures, as everywhere else
\def\theproposition{{\liningfigs\textcolor{thesisaccent}%
   {\thechapter.\arabic{proposition}}}}
\housenobreak{proposition}
\housenobreak{definition}
\housenobreak{corollary}
\housenobreak{remark}
