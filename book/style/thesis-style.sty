% Adapter from the installed hyperref.sty titlesec integration (TeX Live 2026).
% Restore hyperref's titlesec adapter when the class has loaded hyperref
% first. Delay heading targets until titlesec selects the placed heading,
% after its page-reserve check; keep the package's label/write handling.
\@ifundefined{ttl@Hy@steplink}{%
\@ifpackageloaded{titlesec}{%
  \def\ttl@Hy@steplink#1{%
    \Hy@MakeCurrentHrefAuto{#1*}%
    \edef\ttl@Hy@saveanchor{%
      \noexpand\Hy@raisedlink{%
        \noexpand\hyper@anchorstart{\@currentHref}%
        \noexpand\hyper@anchorend
        \def\noexpand\ttl@Hy@SavedCurrentHref{\@currentHref}%
        \noexpand\ttl@Hy@PatchSaveWrite
      }%
    }%
  }%
  \def\ttl@Hy@PatchSaveWrite{%
    \begingroup
      \toks@\expandafter{\ttl@savewrite}%
      \edef\x{\endgroup
        \def\noexpand\ttl@savewrite{%
          \let\noexpand\@currentHref
              \noexpand\ttl@Hy@SavedCurrentHref
          \the\toks@
        }%
      }%
    \x
  }%
  \def\ttl@Hy@refstepcounter#1{%
    \let\ttl@b\Hy@raisedlink
    \def\Hy@raisedlink##1{%
      \def\ttl@Hy@saveanchor{\Hy@raisedlink{##1}}%
    }%
    \refstepcounter{#1}%
    \let\Hy@raisedlink\ttl@b
  }%
}{}
}{}

%-----------------------------------------------------------------------------!
% ACCENT: the marine teal of the group's theses. Used for the title-page
% identity line, ORCiD, hyperlinks and citations. Nothing else.
%-----------------------------------------------------------------------------!
\definecolor{thesisaccent}{RGB}{4,90,117}
% the neutral of the figure system, for incumbents and secondary marks
\definecolor{thesisgrey}{RGB}{110,114,117}
% Panel tags in captions, set in the accent like figure numbers; the
% description that follows stays in text colour.
\DeclareRobustCommand{\ptag}[1]{{\color{thesisaccent}(#1)}}

%-----------------------------------------------------------------------------!
% GEOMETRY: symmetric ~31.7 mm margins, one-sided page furniture, but every
% section opens on an odd page with an empty verso before it where needed,
% as in the group's bound theses.  The class only inserts that page under
% twoside, so the clear is redefined to work from the folio alone.
%-----------------------------------------------------------------------------!
\geometry{a4paper, textwidth=146.5mm, hmarginratio=1:1, bindingoffset=0mm}
\renewcommand{\cleardoublepage}{\clearpage
   \ifodd\value{page}\else\hbox{}\thispagestyle{empty}\newpage\fi}

%-----------------------------------------------------------------------------!
% PARAGRAPHS: parskip convention (house preference)
%-----------------------------------------------------------------------------!
\setlength{\parindent}{0pt}
\setlength{\parskip}{2.0ex plus 0.4ex minus 0.2ex}
\frenchspacing
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

%-----------------------------------------------------------------------------!
% RUNNING HEADERS
% ---------------
% One-sided: folio ALWAYS top right, body size, upright. Wayfinding mark
% top left in italic mixed case: current section, falling back to the
% chapter title while a chapter has no section yet. Hairline rule on body
% pages only; plain (display) pages carry the folio alone.
%-----------------------------------------------------------------------------!
% Capture Chapter/Appendix with each mark, before an appendix transition
% can change the prefix while the preceding page is waiting to ship out.
\newtitlemark{\chaptertitlename}
% Explicit page breaks can precede the pre-heading mark. On a truly empty
% page, both halves must name the incoming title rather than the old one.
% A queued top float still belongs to the outgoing section, even when the
% body page total is zero; retain that section until the float has shipped.
\patchcmd{\ttl@premark}
   {\protected@xdef\ttl@prevmarks{\ttl@marks}}
   {\ifdim\pagetotal=\z@
      \ifx\@toplist\@empty
         \gdef\ttl@prevmarks{\ttl@marks}%
      \else
         \protected@xdef\ttl@prevmarks{\ttl@marks}%
      \fi
    \else
      \protected@xdef\ttl@prevmarks{\ttl@marks}%
    \fi}
   {}{\PackageError{thesis-style}{Cannot patch empty-page title marks}{}}
% Activate titleps's public mark setup, then retain fancyhdr for rendering.
\newpagestyle{thesismarksetup}{}
\pagestyle{thesismarksetup}
\pagestyle{fancy}
\newcommand{\thesisrunningtitle}{%
   \begingroup
   \toptitlemarks
   \iftitle{section}{%
      \ifthesection{\thesection.\ \ }{}\sectiontitle}{%
      \ifthechapter{\chaptertitlename\ \thechapter.\ \ }{}\chaptertitle}%
   \endgroup}
% Adapt the explicit chapter-level marks used by the front matter. Legacy
% class calls wrap References in MakeUppercase; store the original case.
\setmarkboth{%
   \begingroup
   \let\MakeUppercase\@firstofone
   \chaptermark{#1}%
   \endgroup}
\fancyhf{}
\fancyhead[R]{\thepage}
\fancyhead[L]{\color{black!55}\itshape\thesisrunningtitle}
\renewcommand{\headrule}{%
   \ifdim\headrulewidth>0pt
      {\color{black!55}\hrule width\headwidth height\headrulewidth}%
   \fi}
\fancypagestyle{plain}{%
   \fancyhf{}\fancyhead[R]{\thepage}%
   \renewcommand{\headrulewidth}{0pt}}

%-----------------------------------------------------------------------------!
% CHAPTER OPENINGS
% ----------------
% Demeyere's geometry with Mostofi's label: "Chapter N" in regular-weight
% letterspaced small caps (no double bold), \Huge bold ragged-right title,
% deep drop, first body line ~0.37 of the page. No rules, no ornaments.
%-----------------------------------------------------------------------------!
\DeclareRobustCommand{\chapternumeral}[1]{%
   {\color{thesisaccent}\liningfigs\fontsize{52}{52}\selectfont #1}}
\newcommand*{\chapheadrow}{%
   \hbox to \linewidth{%
      \raisebox{0.55\height}{\color{black!55}\large\displaylabel{\@chapapp}}%
      \hfil\chapternumeral{\thechapter}}}
\titleformat{\chapter}[display]
   {\normalfont\setlength{\parskip}{0pt}}
   {\chapheadrow}
   {14pt}
   {\fontsize{27}{32}\selectfont\raggedright}
\titleformat{name=\chapter,numberless}[display]
   {\normalfont}{}{0pt}{\fontsize{27}{32}\selectfont\raggedright}
\titlespacing*{\chapter}{0pt}{45pt}{40pt}
\titleformat{\section}
   {\fontsize{16}{19}\selectfont\raggedright}
   {{\color{thesisaccent}\liningfigs\thesection}}{0.6em}{}
\titlespacing*{\section}{0pt}{3.5ex}{2.3ex}
\titleformat{\subsection}
   {\fontsize{14.4}{16}\selectfont\raggedright}
   {{\color{thesisaccent}\liningfigs\thesubsection}}{0.6em}{}
\titlespacing*{\subsection}{0pt}{3.25ex}{1.5ex}
\titlespacing*{\subsubsection}{0pt}{3ex}{1.2ex}
% A heading must not open in the foot of a page (notes/LAYOUT_RULES.md, H1
% and H2): if less than \sectionneed of the block remains, a section opens
% the next page instead; subsections need \subsectionneed.  titlesec calls
% \sectionbreak and \subsectionbreak before the respective titles.
\newlength{\sectionneed}\setlength{\sectionneed}{0.36\textheight}
\newlength{\subsectionneed}\setlength{\subsectionneed}{0.24\textheight}
\newcommand{\sectionbreak}{\Needspace{\sectionneed}}
\newcommand{\subsectionbreak}{\Needspace{\subsectionneed}}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{2}

%-----------------------------------------------------------------------------!
% FLOATS AND CAPTIONS
% -------------------
% One caption system for figures and tables: small-caps label, ROMAN
% single-spaced caption text one step down, justified in a measure inset
% 1.5em each side. Figure captions below, table captions above. Floats
